{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-sql"],
  "overrides": [
    {
      "files": "**/*.sql",
      "options": {
        "parser": "sql",
        "formatter": "sql-formatter",
        "language": "postgresql",
        "keywordCase": "upper",
        "identifierCase": "preserve",
        "logicalOperatorNewline": "before"
      }
    },
    {
      "files": "**/*.md",
      "options": {
        "parser": "markdown",
        "proseWrap": "never"
      }
    },
    {
      "files": [".prettierrc", ".releaserc"],
      "options": {
        "parser": "json"
      }
    },
    {
      "files": [
        "internals/play-compiler/examples/**/*.{ts,js}",
        "internals/play-compiler/vite/*.mini.ts",
        "packages/compiler/**/*.md",
        "packages/compiler/__test__/fixtures/**/*.{ts,js}"
      ],
      "options": {
        "semi": true
      }
    }
  ]
}
