{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["esnext"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    "strict": true,
    "allowJs": true,

    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["code", "algorithm", "docs"],
  "exclude": ["docs/auth/demo"],
  "ts-node": {
    "transpileOnly": true
  }
}
