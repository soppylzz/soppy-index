{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true
  },
  "include": ["coding", "docs", "packages/*/src", "internals"],
  "exclude": [
    "**/dist",
    "**/node_modules",
    // dir with self-hosted tsconfigs
    "docs/auth/demo",
    "internals/play-compiler/examples",
    "internals/play-compiler/fixtures"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}
