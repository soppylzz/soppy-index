{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true
  },
  "include": ["coding", "docs", "packages/*/src", "internals"],
  "exclude": [
    "**/dist",
    "**/node_modules",
    // dir with self-hosted tsconfigs
    "docs/security/demo",
    "docs/browser/cache/demo",
    "docs/browser/lifecycle/demo",
    "docs/browser/loading/demo",
    "docs/browser/observer/demo",
    "docs/browser/storage/cookie/demo",
    "docs/browser/storage/indexedDB/demo",
    "docs/browser/storage/storageManagement/demo",
    "docs/browser/storage/webStorage/demo",
    "docs/node/http/demo",
    "internals/play-compiler/examples",
    "internals/play-compiler/fixtures"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}
