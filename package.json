{
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "build": "pnpm --filter \"./packages/*\" --if-present -r build",
    "typecheck": "tsc --noEmit && pnpm --filter \"./packages/*\" --filter \"./internals/*\" --if-present -r typecheck",
    "test": "pnpm --filter @soppy-index/test run test",
    "test:compiler": "pnpm --filter @soppy-index/test run test compiler",
    "test:maps": "pnpm --filter @soppy-index/test run test compiler/maps",
    "test:vite": "pnpm --filter @soppy-index/test run test compiler/vite",
    "test:cli": "pnpm --filter @soppy-index/test run test compiler/cli",
    "compiler": "node --conditions=development internals/compiler-cli/src/index.ts",
    "compiler:check": "pnpm compiler check internals/play-compiler/examples/hello.ts",
    "compiler:inspect": "pnpm compiler inspect internals/play-compiler/examples/hello.ts",
    "compiler:hello": "pnpm --filter @soppy-index/play-compiler run hello",
    "compiler:hello:js": "pnpm --filter @soppy-index/play-compiler run hello:js",
    "compiler:modules": "pnpm --filter @soppy-index/play-compiler run modules",
    "compiler:modules:cjs": "pnpm --filter @soppy-index/play-compiler run modules:cjs",
    "play:compiler": "pnpm --filter @soppy-index/play-compiler run dev",
    "play:compiler:build": "pnpm --filter @soppy-index/play-compiler run build",
    "play:compiler:preview": "pnpm --filter @soppy-index/play-compiler run preview",
    "auth:dev": "pnpm --filter auth-next-session-lab run dev",
    "auth:typecheck": "pnpm --filter auth-next-session-lab run typecheck",
    "test:built": "pnpm build && pnpm --filter @soppy-index/test run test:built",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "^10.0.1",
    "@type-challenges/utils": "^0.1.1",
    "@types/node": "catalog:",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.57.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
