{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(node:*)",
      "Bash(rg *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(npm run lint)",
      "Bash(npx --no-install tsc *)",
      "Bash(npx --no-install eslint *)",
      "Bash(npx --no-install prettier *)"
    ]
  }
}
